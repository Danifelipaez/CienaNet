# === Base de datos (Supabase) ===
# Nombres generados por la integración Vercel-Supabase — no renombrar, config.py los lee tal cual.
# Pooler de transacción (puerto 6543) — usado por la app en runtime (pgBouncer, sin prepared statements).
POSTGRES_PRISMA_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Conexión directa (puerto 5432) — usada SOLO por Alembic para migraciones.
POSTGRES_URL_NON_POOLING=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# === Supabase API ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# === Meta WhatsApp Cloud API ===
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# === Provider de WhatsApp: "meta" (default, oficial) o "evolution" ===
# "evolution" = Baileys vía Evolution API self-hosted, solo para mientras la
# verificación de negocio de Meta está pendiente (docs/WHATSAPP_API.md).
# Volver a "meta" apenas se apruebe la cuenta — no es apto para producción real.
WHATSAPP_PROVIDER=meta
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Secreto propio (no lo da Evolution) para el query param ?token= del webhook
# /api/v1/webhook/evolution — inventarlo con: openssl rand -hex 16
EVOLUTION_WEBHOOK_SECRET=

# === IA / NLU (Google AI Studio / Gemini) ===
# API key de Google AI Studio (https://aistudio.google.com/apikey). Vacío = stub, sin IA.
AI_API_KEY=
# Id del modelo de AI Studio. Ajustar al id exacto cuando se confirme (p.ej. gemini-flash-3-lite).
AI_MODEL=gemini-flash-lite-latest
# Mensajes previos que se mandan como contexto en conversaciones de WhatsApp.
AI_HISTORY_TURNS=10

# === App ===
ENVIRONMENT=development
# Salt para hashear API keys de sensores: openssl rand -hex 32
SENSOR_API_KEY_SECRET=
# Clave para el endpoint /admin/* (protege registro de sensores): openssl rand -hex 32
ADMIN_API_KEY=change-me
# true SOLO en el servidor universitario (dueño del webhook + scheduler).
# Vercel y local quedan en false (default) — Vercel usa su cron diario
# existente (vercel.json), que solo refresca snapshot y nunca manda alertas.
# Ver docs/DEPLOYMENT.md.
RUN_SCHEDULER=false
# Orígenes de navegador con permiso CORS, separados por coma. Vacío por
# defecto: el frontend llama a este backend server-to-server, nunca desde el
# navegador — dejar vacío salvo que se agregue un endpoint público de navegador.
CORS_ALLOWED_ORIGINS=

# === Coordenadas Ciénaga Grande (no secretos, tienen default en config.py) ===
# Centroide real medido (ver docs/KNOWLEDGE_BASE.md #12)
CIENAGA_LAT=10.859056
CIENAGA_LON=-74.460611
# Tasajera (dato comunitario ilustrativo, no medición territorial validada)
TASAJERA_LAT=10.972
TASAJERA_LON=-74.434

# === Alerta de vendaval (docs/ALERTAS_VENDAVAL.md) ===
# Ráfaga (km/h) a partir de la cual se avisa por WhatsApp. 62 km/h = piso de
# "vendaval" en escala Beaufort (grado 8) — no es un número oficial de IDEAM.
VENDAVAL_GUST_THRESHOLD_KMH=62.0
# Horas hacia adelante que se revisan en el pronóstico de Open-Meteo.
VENDAVAL_FORECAST_HOURS=48

# === Alerta de lluvia (docs/ALERTAS_LLUVIA.md) — todos tienen default en config.py ===
# Caja de la CGSM y anillo 20-60 km para el nowcast satelital GOES-19 RRQPE.
LLUVIA_CAJA_LAT_MIN=10.54
LLUVIA_CAJA_LAT_MAX=11.01
LLUVIA_CAJA_LON_MIN=-74.69
LLUVIA_CAJA_LON_MAX=-74.32
LLUVIA_ANILLO_LAT=10.85
LLUVIA_ANILLO_LON=-74.50
LLUVIA_ANILLO_KM_MIN=20.0
LLUVIA_ANILLO_KM_MAX=60.0
# "lloviendo": >=5 % de la caja con >=1 mm/h. "inminente": caja seca y >=2 % del
# anillo con >=5 mm/h (3 % = versión conservadora: menos falsas alarmas, menos aciertos).
LLUVIA_CAJA_UMBRAL=0.05
LLUVIA_ANILLO_UMBRAL=0.02
# sin_dato si el scan tiene más de N min o más de este % de píxeles sin valor.
LLUVIA_SCAN_MAX_MIN=25
LLUVIA_NAN_MAX=0.10
# Destellos GLM en 30 min a <=100 km para añadir "tormenta eléctrica".
LLUVIA_RAYOS_UMBRAL=3
# Minutos mínimos entre dos avisos de lluvia por WhatsApp.
LLUVIA_DEDUP_MIN=60

# === Avisos del tiempo (docs/AVISOS_CLIMA.md) — todos tienen default en config.py ===
# Ventana hacia adelante (h) y modelos que deben coincidir (de ECMWF, GFS, ICON) para empujar WhatsApp.
AVISO_HORAS=36
AVISO_CONSENSO=2
# Viento/ráfaga = umbrales del semáforo rojo; lluvia (mm en 6 h) y ola (m) calibrados 2024-2025.
AVISO_VIENTO_KMH=30.0
AVISO_RAFAGA_KMH=45.0
AVISO_LLUVIA_MM_6H=10.0
AVISO_OLA_M=1.5
AVISO_CICLON_KM=1000.0
# Punto de mar frente a la Boca de la Barra para el oleaje.
MAR_LAT=11.05
MAR_LON=-74.45
# Xweather: solo desempate cuando 1 de 3 modelos ve el evento. Misma cuenta que el radar del
# frontend (15.000 tokens/periodo). Vacío = nunca se consulta. Ponerlo SOLO en el deployment
# con RUN_SCHEDULER=true para no gastar cuota desde otras instancias.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
# Tokens del periodo que se dejan libres para el radar del frontend.
XWEATHER_RESERVA_TOKENS=1000
